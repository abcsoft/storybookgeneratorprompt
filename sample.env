# Google Gemini API key (https://aistudio.google.com/apikey)
# Copy this file to .env.local and paste your key below.
GEMINI_API_KEY=

# --- Optional overrides (sensible defaults are built in) ---
# GEMINI_MODEL=gemini-3.1-flash-image   # Nano Banana 2
# IMAGE_SIZE=2K                          # 1K | 2K | 4K
# GEN_CONCURRENCY=1                      # pages drawn in parallel (1 = one-at-a-time)
# STORYBOOK_OUT_DIR=storybook-out        # where per-child folders (images/prompts/pdf) are saved

# --- Free web generation (npm run web-generate) ---
# Drives gemini.google.com with your Pro plan instead of the paid API.
# Persistent Chrome profile holding your logged-in Google session (log in once).
# GEMINI_WEB_PROFILE_DIR=~/.storybook-gemini-profile
